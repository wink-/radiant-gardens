---
// Small stroke-style line icons (44px) used on cards.
const icons = {
  design:
    '<rect x="3.5" y="4.5" width="17" height="15" rx="2"/><path d="M7 15.5l8.5-8.5 2 2L9 17.5H7v-2Z"/><path d="M7.5 8.5h5"/>',
  trowel:
    '<path d="M4 20c0-6 3.5-9.5 8-10l2 2c-.5 4.5-4 8-10 8Z"/><path d="M13 11l7-7"/>',
  sprout:
    '<path d="M12 20v-8"/><path d="M12 12C12 8 9 6 5 6c0 4 3 6 7 6Z"/><path d="M12 12c0-3.5 2.5-5.5 7-5.5 0 4-3 5.5-7 5.5Z"/><path d="M5 20h14"/>',
  hub: '<rect x="3" y="4.5" width="18" height="12.5" rx="2"/><path d="M9.5 21h5"/><path d="M12 13.5c-2.6 0-4.2-1.6-4.4-4.2 2.8-.3 4.4 1.5 4.4 4.2Z"/><path d="M12 13.5c0-2.3 1.6-3.6 4.2-3.6.2 2.6-1.6 3.9-4.2 3.6Z"/>',
  leafy:
    '<path d="M5 19C5 11.5 10 6.5 19 6c.5 8.5-4.5 13.5-14 13Z"/><path d="M5 19c3.5-4.5 7-8 12.5-11.5"/>',
  calendar:
    '<rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 9.5h16M8 3v4M16 3v4"/><path d="M8.5 14l2.5 2.5 4.5-4.5"/>',
  flask:
    '<path d="M10 3.5h4"/><path d="M12 3.5V9l5 9a1.5 1.5 0 0 1-1.3 2.2H8.3A1.5 1.5 0 0 1 7 18l5-9V3.5"/><path d="M8.8 14.5h6.4"/>',
  refresh:
    '<path d="M4 9c1.5-3 4.5-5 8-5 3 0 5.5 1.4 7 4"/><path d="M19 4v4h-4"/><path d="M20 15c-1.5 3-4.5 5-8 5-3 0-5.5-1.4-7-4"/><path d="M5 20v-4h4"/>',
  expand:
    '<rect x="4" y="4" width="16" height="16" rx="2"/><path d="M12 9v6M9 12h6"/>',
} as const;

type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class={className}
  width="44"
  height="44"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
  set:html={icons[name]}
/>
